# SmartRO server settings. Lives at /opt/smartro/.env on the VPS.
# server-up.sh created this file and filled in the secrets once.
# After editing run:  smartro up -d
# (changing PUBLIC_HOST also needs:  smartro up -d --build)

# ── Address ──────────────────────────────────────────────────────────────
# The VPS hostname from hPanel (srvXXXXXX.hstgr.cloud) or your own domain.
# Its DNS must point at this server, or HTTPS certificates can't be issued.
PUBLIC_HOST=__PUBLIC_HOST__
CORS_ORIGINS=https://__PUBLIC_HOST__

# ── Secrets (generated; don't change once customers have logged in) ──────
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__

# ── Login ────────────────────────────────────────────────────────────────
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_DEV_RETURN=false
# Phone login: put the key file at /opt/smartro/secrets/firebase-service-account.json
# (deploy.sh uploads deploy/hostinger/secrets/firebase-service-account.json),
# or paste the whole key here on ONE line inside single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Payments ─────────────────────────────────────────────────────────────
# stub: payment routes answer 503 in production. Switch to razorpay once
# the keys below are filled. Webhook URL for the Razorpay dashboard:
#   https://<PUBLIC_HOST>/api/v1/webhooks/razorpay
PAYMENT_DRIVER=stub
PAYMENT_STUB_DELAY_MS=1500
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── SMS / WhatsApp / push ────────────────────────────────────────────────
MESSAGING_DRIVER=stub
PUSH_DRIVER=stub
EXPO_ACCESS_TOKEN=

# ── Business rules ───────────────────────────────────────────────────────
TRIAL_DAYS=7
INSTALL_LEAD_HOURS=6
REFERRAL_REWARD_PAISE=20000
