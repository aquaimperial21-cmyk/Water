# SmartRO admin (Next.js) — production env template.
#
# NEXT_PUBLIC_* values are baked into the client bundle at `next build` time.
# Set this in the Vercel project dashboard → Settings → Environment Variables
# (Production scope), or pass as `vercel deploy --env NEXT_PUBLIC_API_URL=…`.
#
# DO NOT commit a populated copy of this file.

# Backend public URL (must include /api/v1 suffix).
NEXT_PUBLIC_API_URL=https://api.smartro.in/api/v1
