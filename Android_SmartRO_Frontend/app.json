{
  "expo": {
    "name": "SmartRO",
    "slug": "smartro-customer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0E7C66",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.smartro.customer"
    },
    "android": {
      "package": "in.smartro.customer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0E7C66"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "eas": {
        "projectId": "ba0f7967-4248-4fa1-b993-1dfffa9ed5c5"
      }
    },
    "owner": "aquaimperial"
  }
}
