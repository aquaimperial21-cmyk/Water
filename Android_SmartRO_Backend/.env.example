# SmartRO backend env

# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for prototype; switch to postgresql:// for prod)
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
OTP_TTL_SECONDS=300
OTP_DEV_RETURN=true   # when true, /auth/otp/request returns the OTP in the response (DEV ONLY)

# Messaging / SMS provider
#   stub  → logs to console only (default; safe for dev)
MESSAGING_DRIVER=stub

# Payment stub: how long the stub routes wait before marking a payment paid
PAYMENT_STUB_DELAY_MS=1500

# Payment gateway driver
#   stub     → no gateway. POST /bookings/:id/pay and /subscriptions/:id/recharge
#              write the Payment row and mark it SUCCESS (default; dev only, as
#              these routes return 503 when NODE_ENV=production)
#   razorpay → real Razorpay orders + signature-verified webhooks
#              (setup: README.md → "Razorpay payments")
PAYMENT_DRIVER=stub

# Razorpay (only needed when PAYMENT_DRIVER=razorpay)
# Dashboard → Account & Settings → API Keys. Test keys start with rzp_test_.
# Restart the backend after editing; tsx watch does not reload .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured in Razorpay Dashboard → Webhooks. Used to verify the
# X-Razorpay-Signature header on inbound webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=

# CORS (comma-separated list of allowed origins; * for everything during dev)
CORS_ORIGINS=*

# Trial & lock-in (livpure-parity)
TRIAL_DAYS=7

# Install scheduling
# Earliest install slot is now + INSTALL_LEAD_HOURS (default 6h, matches 48–72h promise)
INSTALL_LEAD_HOURS=6

# Referrals — reward credited to referrer + first-month discount to referee
REFERRAL_REWARD_PAISE=20000

# Push notifications driver
#   stub → log to console only (default)
#   expo → POST to https://exp.host/--/api/v2/push/send (works for both FCM + APNs)
PUSH_DRIVER=stub
EXPO_ACCESS_TOKEN=               # optional; required for Expo "enhanced security" mode

# Firebase Admin (phone OTP verification)
#   Local dev: leave the JSON var empty and keep the key file at the path below.
#   Hostinger: the key file goes in /opt/smartro/secrets/ (deploy/hostinger/README.md).
#   Hosts that can't mount files: paste the whole JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
