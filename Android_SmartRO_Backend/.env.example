# SmartRO backend env

# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for prototype; switch to postgresql:// for prod)
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
OTP_TTL_SECONDS=300
OTP_DEV_RETURN=true   # when true, /auth/otp/request returns the OTP in the response (DEV ONLY)

# Messaging / SMS provider
#   stub  → logs to console only (default; safe for dev)
#   msg91 → sends real SMS via MSG91 Flow API (production)
MESSAGING_DRIVER=stub

# MSG91 (only needed when MESSAGING_DRIVER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=                  # optional; DLT-registered 6-char sender ID
MSG91_TEMPLATE_AUTH_OTP=          # MSG91 template_id for the OTP template

# Payment stub
PAYMENT_STUB_DELAY_MS=1500

# Payment gateway driver
#   stub     → in-memory stub (default; safe for dev)
#   razorpay → real Razorpay orders + signature-verified webhooks
PAYMENT_DRIVER=stub

# Razorpay (only needed when PAYMENT_DRIVER=razorpay)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured in Razorpay Dashboard → Webhooks. Used to verify the
# X-Razorpay-Signature header on inbound webhook deliveries.
RAZORPAY_WEBHOOK_SECRET=

# CORS (comma-separated list of allowed origins; * for everything during dev)
CORS_ORIGINS=*

# Trial & lock-in (livpure-parity)
TRIAL_DAYS=7

# Install scheduling
# Earliest install slot is now + INSTALL_LEAD_HOURS (default 6h, matches 48–72h promise)
INSTALL_LEAD_HOURS=6

# Referrals — reward credited to referrer + first-month discount to referee
REFERRAL_REWARD_PAISE=20000

# Push notifications driver
#   stub → log to console only (default)
#   expo → POST to https://exp.host/--/api/v2/push/send (works for both FCM + APNs)
PUSH_DRIVER=stub
EXPO_ACCESS_TOKEN=               # optional; required for Expo "enhanced security" mode
