# SmartRO backend env

# Server
PORT=4000
NODE_ENV=development

# Database (SQLite for prototype; switch to postgresql:// for prod)
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
OTP_TTL_SECONDS=300
OTP_DEV_RETURN=true   # when true, /auth/otp/request returns the OTP in the response (DEV ONLY)

# Payment stub
PAYMENT_STUB_DELAY_MS=1500

# CORS (comma-separated list of allowed origins; * for everything during dev)
CORS_ORIGINS=*
