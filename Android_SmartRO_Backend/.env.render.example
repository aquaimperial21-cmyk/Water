# SmartRO backend — free-tier TESTING deploy (Render + Neon).
# These are the env vars to paste into Render's dashboard for the smartro-api
# web service. Stub drivers mean no Razorpay / MSG91 / Expo accounts needed.
#
# For real production with live SMS + payments, see .env.production.example
# (Fly.io template).

NODE_ENV=production
PORT=4000

# Neon Postgres — paste the POOLED connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASS@HOST.neon.tech/neondb?sslmode=require"

# Random secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP — keep DEV_RETURN=true for testing so the OTP comes back in the
# /auth/otp/request response. NEVER set true in real production.
OTP_TTL_SECONDS=300
OTP_DEV_RETURN=true

# Stub drivers — no third-party accounts required.
MESSAGING_DRIVER=stub
PAYMENT_DRIVER=stub
PAYMENT_STUB_DELAY_MS=1500
PUSH_DRIVER=stub

# CORS — start with * for testing, then lock to the Vercel URL:
#   CORS_ORIGINS=https://smartro-admin.vercel.app
CORS_ORIGINS=*

# Business rules
TRIAL_DAYS=7
INSTALL_LEAD_HOURS=6
REFERRAL_REWARD_PAISE=20000
