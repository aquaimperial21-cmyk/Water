# SmartRO backend — production env template.
#
# Set these on Fly via `flyctl secrets set KEY=value KEY2=value2 …`.
# DO NOT commit a populated copy of this file.
#
# Generate the JWT + webhook secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ───────────────────────── Required ─────────────────────────

# Postgres — Neon Mumbai (ap-south-1) connection string.
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# JWT — strong random; rotating these invalidates every refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# OTP — production must NOT return the OTP in the API response.
OTP_DEV_RETURN=false

# CORS — comma-separated. Replace with your real domains. No '*' in prod.
CORS_ORIGINS=https://admin.smartro.in,https://smartro.in

# ───────────────────────── Razorpay (PAYMENT_DRIVER=razorpay) ─────────────────────────

PAYMENT_DRIVER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────────────────────── MSG91 (MESSAGING_DRIVER=msg91) ─────────────────────────

MESSAGING_DRIVER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=                     # optional; DLT 6-char ID
MSG91_TEMPLATE_AUTH_OTP=             # template ID for OTPs
# Per-template IDs for the cron + transactional sends (leave blank to use stub for that channel):
# MSG91_TEMPLATE_RECHARGE_REMINDER_7D=
# MSG91_TEMPLATE_RECHARGE_REMINDER_3D=
# MSG91_TEMPLATE_RECHARGE_REMINDER_1D=
# MSG91_TEMPLATE_TECH_DAILY_SCHEDULE=

# ───────────────────────── Push (PUSH_DRIVER=expo) ─────────────────────────

PUSH_DRIVER=expo
# Optional — enables Expo's "enhanced security" mode. Only needed if you've
# opted in on the Expo dashboard.
# EXPO_ACCESS_TOKEN=

# ───────────────────────── Tuneables (all have sane defaults) ─────────────────────────

# Trial / lock-in / install lead (already in code defaults; override if needed)
# TRIAL_DAYS=7
# INSTALL_LEAD_HOURS=6

# Referral bonus in paise (₹200 = 20000)
# REFERRAL_REWARD_PAISE=20000

# DeviceReading retention window in days — see src/cron/reading-retention.ts
# READING_RETENTION_DAYS=90

# Device grace days after subscription expiry (flow stays open this long)
# DEVICE_GRACE_DAYS=2

# Set to "1" to disable all cron jobs on this instance (useful if running
# a dedicated cron worker separately).
# CRON_DISABLED=
